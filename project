# My-first-repo
<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>University Admission Form</title>
</head>
<body>

    <h2>University Admission Form</h2>

    <form>
        <!-- Personal Information -->
        <fieldset>
            <legend>Personal Information</legend>
            
            <label for="name">Name:</label>
            <input type="text" id="name" name="name"><br><br>

            <label for="dob">Date of Birth:</label>
            <input type="date" id="dob" name="dob"><br><br>

            <label>Gender:</label>
            <input type="radio" id="male" name="gender" value="male" checked>
            <label for="male">Male</label>
            <input type="radio" id="female" name="gender" value="female">
            <label for="female">Female</label><br><br>

            <label for="email">Email:</label>
            <input type="email" id="email" name="email"><br><br>

            <label for="contact">Contact Number:</label>
            <input type="tel" id="contact" name="contact"><br><br>

            <label for="address" style="vertical-align: top;">Address:</label>
            <textarea id="address" name="address" rows="4" cols="50" placeholder="Enter your address"></textarea>
        </fieldset>

        <br>

        <!-- Academic Details -->
        <fieldset>
            <legend>Academic Details</legend>

            <label for="highschool">High School Name:</label>
            <input type="text" id="highschool" name="highschool"><br><br>

            <label for="grad_year">Year of Graduation:</label>
            <input type="text" id="grad_year" name="grad_year"><br><br>

            <label for="gpa">GPA:</label>
            <input type="text" id="gpa" name="gpa"><br><br>

            <label for="major">Intended Major:</label>
            <select id="major" name="major">
                <option value="">Select Major</option>
                <option value="cs">Computer Science</option>
                <option value="ee">Electrical Engineering</option>
                <option value="business">Business</option>
            </select><br><br>

            <label for="transcript">Upload Transcript:</label>
            <input type="file" id="transcript" name="transcript">
        </fieldset>

        <br>

        <!-- Additional Information -->
        <fieldset>
            <legend>Additional Information</legend>

            <label for="extracurricular" style="vertical-align: top;">Extracurricular Activities:</label>
            <textarea id="extracurricular" name="extracurricular" rows="4" cols="50"></textarea><br><br>

            <label>Do you need scholarship?</label>
            <input type="checkbox" id="scholarship" name="scholarship" value="yes">
            <label for="scholarship">Yes</label><br><br>

            <label for="terms">Agree to Terms:</label>
            <input type="checkbox" id="terms" name="terms" checked>
        </fieldset>

        <br>

        <input type="submit" value="Submit Application">
    </form>

</body>
</html>
